# Copy to .env or set in your host's environment.
# All optional — the app works with none of them (uses the built-in engine).
PORT=3000

# LLM for generative AI Analytics (optional).
# Any OpenAI-compatible key works: Groq, Google Gemini, OpenRouter (all free, no card).
# You can also paste the key in the app: Admin -> AI Analytics -> AI Settings.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=